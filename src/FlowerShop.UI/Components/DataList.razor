@typeparam TItem

@if (Loading)
{
    <div class="grid" aria-busy="true">
        @for (var i = 0; i < 6; i++) { <div class="card skeleton"></div> }
    </div>
}
else if (Items is null || Items.Count == 0)
{
    if (Empty is not null) { @Empty } else { <p class="muted center">Nothing here yet.</p> }
}
else
{
    <div class="@CssClass">
        @foreach (var item in Items) { @ItemTemplate(item) }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<TItem>? Items { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string CssClass { get; set; } = "grid";
    [Parameter, EditorRequired] public RenderFragment<TItem> ItemTemplate { get; set; } = default!;
    [Parameter] public RenderFragment? Empty { get; set; }
}
