@page "/checkout"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@inject ApiClient Api
@inject ToastService Toasts
@inject NavigationManager Nav
<PageTitle>Checkout</PageTitle>
<h1>Checkout</h1>

@if (Cart.Lines.Count == 0)
{
    <div class="card center"><p>Your cart is empty.</p><a class="btn" href="">Browse flowers</a></div>
}
else
{
    <EditForm Model="_form" OnValidSubmit="Submit" class="card stack">
        <DataAnnotationsValidator />
        <label>Delivery address
            <InputText @bind-Value="_form.Address" placeholder="Street, house, apartment" autocomplete="street-address" />
            <ValidationMessage For="() => _form.Address" />
        </label>
        <label>Note for the florist (optional)
            <InputTextArea @bind-Value="_form.Note" rows="3" />
            <ValidationMessage For="() => _form.Note" />
        </label>
        <div class="row total"><span>@Cart.Count items · delivery @(Cart.Delivery == 0 ? "free" : Cart.Delivery.ToString("N0") + " ₸")</span><strong>@Cart.Total.ToString("N0") ₸</strong></div>
        @if (_error is not null) { <p class="error" role="alert">@_error</p> }
        <button class="btn wide" type="submit" disabled="@_busy">@(_busy ? "Placing order…" : "Place order")</button>
    </EditForm>
}

@code {
    [CascadingParameter] CartState Cart { get; set; } = default!;
    readonly Form _form = new();
    string? _error;
    bool _busy;

    sealed class Form
    {
        [Required, MinLength(8, ErrorMessage = "Please enter a full address (8+ characters).")] public string Address { get; set; } = "";
        [MaxLength(200)] public string? Note { get; set; }
    }

    async Task Submit()
    {
        _busy = true; _error = null;
        var req = new CreateOrderRequest(_form.Address, _form.Note, Cart.Lines.Select(l => new OrderItemRequest(l.Product.Id, l.Quantity)).ToList());
        var r = await Api.CreateOrderAsync(req);
        _busy = false;
        if (!r.IsOk) { _error = r.Error; return; }
        Cart.Clear();
        Toasts.Success($"Order #{r.Value!.Id} placed!");
        Nav.NavigateTo("orders");
    }
}
