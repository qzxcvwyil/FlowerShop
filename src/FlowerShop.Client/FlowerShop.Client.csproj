<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BlazorEnableCompression>true</BlazorEnableCompression>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="8.0.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FlowerShop.Shared\FlowerShop.Shared.csproj" />
    <ProjectReference Include="..\FlowerShop.UI\FlowerShop.UI.csproj" />
    <ProjectReference Include="..\FlowerShop.Admin\FlowerShop.Admin.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Admin pages are NOT in the initial download; they are fetched when someone opens /admin -->
    <BlazorWebAssemblyLazyLoad Include="FlowerShop.Admin.wasm" />
  </ItemGroup>
</Project>
